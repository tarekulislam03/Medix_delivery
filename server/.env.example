# Environment configuration for Medix Production Server
NODE_ENV=production
PORT=5000

# MongoDB URI (Points to internal container when using Docker Compose)
MONGO_URI=mongodb://mongodb:27017/medix_delivery

# Security
JWT_SECRET=replace_this_with_a_secure_random_64_char_secret_key

# Optional: Firebase Admin SDK for Mobile Push Notifications & OTP
# FIREBASE_SERVICE_ACCOUNT_PATH=/app/serviceAccountKey.json
