# Environment configuration for Medix Server
NODE_ENV=development
PORT=5000

# MongoDB URI (Points to internal container when using Docker Compose)
MONGO_URI=mongodb://mongodb:27017/medix_delivery

# Security
JWT_SECRET=medix_production_secure_jwt_secret_token_key_789456123

# Fast2SMS OTP Integration (Get your API key at https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Firebase Admin SDK Configuration
# Option 1: Inline service account JSON string (one line or escaped JSON)
# Option 2: File path (e.g. /app/serviceAccountKey.json or ./serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT=your_firebase_service_account_json_or_file_path
