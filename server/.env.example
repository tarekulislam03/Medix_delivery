# ==========================================
# Medix Medicine Delivery App - Environment Config
# ==========================================

# Node & Server
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB Connection String (With Connection Pooling maxPoolSize=25)
MONGO_URI=mongodb://127.0.0.1:27017/medix_delivery

# JWT Authentication Secrets (15-min Access Tokens, 30-day Refresh Tokens)
JWT_SECRET=medix_production_secure_jwt_secret_token_key_789456123
JWT_REFRESH_SECRET=medix_production_secure_jwt_refresh_secret_token_key_159357

# Default Admin User (For initial seed or automated administration)
ADMIN_PHONE=+919876543210
ADMIN_PASSWORD=MedixAdmin@2026
ADMIN_PIN=123456

# SMS Provider Configuration for OTP Delivery
# In development (NODE_ENV=development), OTPs are logged directly to the server console.
# 1. APITxT (Primary Provider)
APITXT_API_KEY=your_apitxt_api_key_here
APITXT_SENDER_ID=your_dlt_sender_id
APITXT_TEMPLATE_ID=your_dlt_template_id
# DLT template for login OTP: "Your login OTP is {#var#}, do not share with anyone. Team Medix"
APITXT_OTP_TEMPLATE_ID=your_dlt_otp_template_id
APITXT_PE_ID=your_dlt_principal_entity_id

# 2. Fast2SMS (Secondary / Fallback Provider)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Optional Redis Adapter for Socket.io Horizontal Multi-Node Scaling
# If unset, Socket.io runs with high-performance in-memory room management.
# REDIS_URL=redis://localhost:6379

# Firebase Admin SDK (Optional for push notifications)
FIREBASE_SERVICE_ACCOUNT=
