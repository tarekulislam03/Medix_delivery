{
  "name": "medix-delivery",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/customer",
    "server"
  ],
  "scripts": {
    "dev:customer": "npm --prefix apps/customer run dev",
    "dev:server": "npm --prefix server run dev",
    "seed:medicines": "npm --prefix server run seed:medicines",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "tunnel": "cloudflared tunnel --url http://localhost:5173",
    "tunnel:api": "cloudflared tunnel --url http://localhost:5000"
  }
}
